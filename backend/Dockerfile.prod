# T210: Production image — multi-stage uv build, non-root user, no dev deps.
#
# Build:
#   docker build -f backend/Dockerfile.prod -t aueshah-concierge:prod backend
# Run (env vars come from your secret manager):
#   docker run --rm -p 8000:8000 --env-file /secrets/.env aueshah-concierge:prod

# ─── Stage 1: builder — uv resolves and installs into a virtualenv ─────────
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

# Build deps for any wheels that need C compilation (asyncpg, cryptography, etc.).
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libpq-dev curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /usr/local/bin/

WORKDIR /build

# Resolve and install only main deps (no dev) into the staged venv.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Now copy app source and finalize the venv.
COPY app/ ./app/
RUN uv sync --frozen --no-dev


# ─── Stage 2: runtime — slim, non-root, only runtime deps ───────────────────
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PORT=8000 \
    LOG_LEVEL=INFO

# Runtime libs only.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpq5 curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 1001 app \
 && useradd  --system --uid 1001 --gid app --no-create-home --shell /usr/sbin/nologin app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build/app /srv/app/app

WORKDIR /srv/app
USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:${PORT}/health || exit 1

# uvicorn directly: simpler than gunicorn + worker class for an async-only app.
# Tune --workers via env or a process manager; default 2 keeps memory predictable.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --workers ${UVICORN_WORKERS:-2} --log-level ${LOG_LEVEL,,} --proxy-headers --forwarded-allow-ips=*"]
