# OpenAI Configuration
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4-turbo-preview

# Qdrant Configuration
QDRANT_URL=https://871454ad-bbaf-4bc5-a23a-1245716131d4.eu-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6OTAzNDIxNDktOGIxZC00NmQzLWJlODItMzc4ZjQ4ZDQyMmI4In0.WowHc_PuhJ3lL9fRvUaDlv-kJIo2-jf60KbJjHOZViM

# Application Configuration
CHAT_TIMEOUT_SECONDS=4
RAG_TIMEOUT_SECONDS=0.5
ROUTING_TIMEOUT_MS=200
LOG_LEVEL=INFO

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small

# Phase 2: Neon Serverless Postgres
NEON_DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/aueshah?ssl=require

# Phase 2: Redis (Upstash)
REDIS_URL=rediss://default:xxx@us1-xxx.upstash.io:6379

# Phase 2: Rate Limiting & Timeout
# Rate limiting is always on when REDIS_URL is set; omit REDIS_URL to disable.
RATE_LIMIT_PER_MIN=5
REQUEST_TIMEOUT_SECONDS=15
MAX_CONTEXT_MESSAGES=15

# Phase 2: WordPress Auth (HS256 via JWT Authentication for WP-API plugin)
WP_BASE_URL=https://aueshah.com
WP_ISSUER=https://aueshah.com
# Paste the JWT_AUTH_SECRET_KEY value from wp-config.php below:
JWT_AUTH_SECRET_KEY=

# Phase 2: Session JWT
JWT_SIGNING_KEY=generate-with-openssl-rand-hex-32
JWT_EXPIRES_SECONDS=86400

# Phase 2: Admin
ADMIN_API_TOKEN=generate-with-openssl-rand-hex-24

# Phase 2: Resend (transactional email)
RESEND_API_KEY=re_xxx
# Until aueshah.com is verified in Resend, use the sandbox sender below.
RESEND_FROM_EMAIL=Aueshah Concierge <onboarding@resend.dev>
# Inbox(es) where appointment + Noor concierge alerts are delivered.
# Comma-separated for multiple recipients (one Resend send per recipient).
CONCIERGE_ALERT_EMAIL=shahs.jewel@gmail.com,service@aueshah.com

# Phase 2: Business Logic
NOOR_COOLDOWN_DAYS=90
